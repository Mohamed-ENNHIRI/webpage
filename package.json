{
  "name": "martin-thebault-fr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal research site for Martin Thebault — static HTML/CSS/JS, built from Markdown.",
  "scripts": {
    "build": "node build/build.mjs",
    "hal": "node build/hal.mjs && node build/thumbnails.mjs",
    "dev": "node build/serve.mjs",
    "clean": "rm -rf _site _site.tmp.* _site.old.*",
    "thumbnails": "node build/thumbnails.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
